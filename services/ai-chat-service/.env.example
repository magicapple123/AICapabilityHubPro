SERVICE_NAME=ai-chat-service
CAPABILITY_SERVICE_NAME=capability-service
# internal is strict. Opt into market only while using the legacy published catalog.
CAPABILITY_CATALOG_MODE=internal
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8090
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_CLUSTER=DEFAULT
NACOS_MODEL_CONFIG_ENABLED=true
NACOS_MODEL_CONFIG_DATA_ID=ai-chat-service-model.json
NACOS_CONFIG_TIMEOUT=5
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/ai_chat_db?charset=utf8mb4
INTERNAL_CALL_TIMEOUT=10
ENABLE_INTERNAL_CHAIN=true
USER_SERVICE_NAME=user-service
BILLING_SERVICE_NAME=billing-service
POINTS_COST=1
MODEL_TIMEOUT=30
MODEL_MAX_TOKENS=1024
DEFAULT_SYSTEM_PROMPT=你是一个严谨的中文 AI 助手，回答尽量简洁。
DEFAULT_TEMPERATURE=0.7
USE_MOCK=true
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=replace-me
# 服务端默认模型名；真实供应商必须填其模型目录里的名称（如 deepseek-flash）。
# 请求体显式传 model 时以请求为准，二者都为空才回落到 mock-model。
MODEL_NAME=mock-model
# OpenAI 兼容层（/v1）：客户端把 Base URL 指向 http://<host>:8080/v1，
# API Key 填平台 API Key 的 Secret（sk_...）。关闭后 /v1 路由不注册。
OPENAI_COMPAT_ENABLED=true
OPENAI_COMPAT_MODEL_MAP=deepseek-flash=1,deepseek-chat=1,chat-completions=1
# 服务间令牌由该密钥派生（需与网关 JWT_SECRET 一致，至少 32 字节）；
# 本地由 scripts/start_*.py 统一注入，手工启动时才需要显式填写。
JWT_SECRET=
