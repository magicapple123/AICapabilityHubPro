SERVICE_NAME=ai-chat-service
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8090
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_CLUSTER=DEFAULT
NACOS_MODEL_CONFIG_ENABLED=true
NACOS_MODEL_CONFIG_DATA_ID=ai-chat-service-model.json
NACOS_CONFIG_TIMEOUT=5
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/ai_chat_db?charset=utf8mb4
INTERNAL_CALL_TIMEOUT=10
ENABLE_INTERNAL_CHAIN=true
USER_SERVICE_NAME=user-service
BILLING_SERVICE_NAME=billing-service
POINTS_COST=1
MODEL_TIMEOUT=30
MODEL_MAX_TOKENS=1024
DEFAULT_SYSTEM_PROMPT=你是一个严谨的中文 AI 助手，回答尽量简洁。
DEFAULT_TEMPERATURE=0.7
USE_MOCK=true
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=replace-me
