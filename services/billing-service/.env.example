SERVICE_NAME=billing-service
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8083
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_CLUSTER=DEFAULT
NACOS_MODEL_CONFIG_ENABLED=false
NACOS_MODEL_CONFIG_DATA_ID=billing-service-model.json
NACOS_CONFIG_TIMEOUT=5
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/billing_db?charset=utf8mb4
INTERNAL_CALL_TIMEOUT=10

# 仅通过服务发现调用 user-service 的内部契约，不读 user_db。
USER_SERVICE_NAME=user-service

# 用量统计默认回看天数。
STAT_DEFAULT_RANGE_DAYS=30

USE_MOCK=true
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=replace-me
