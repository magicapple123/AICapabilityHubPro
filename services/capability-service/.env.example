SERVICE_NAME=capability-service
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8082
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_CLUSTER=DEFAULT
NACOS_MODEL_CONFIG_ENABLED=false
NACOS_MODEL_CONFIG_DATA_ID=capability-service-model.json
NACOS_CONFIG_TIMEOUT=5
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/capability_db?charset=utf8mb4
INTERNAL_CALL_TIMEOUT=10
USER_SERVICE_NAME=user-service
USE_MOCK=true
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=replace-me

# A2 连接池与多 worker（默认值与改造前一致：5 + 10 溢出）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# 生产建议 4；4 服务 × 4 worker × 15 = 240，MySQL max_connections 必须 ≥300
UVICORN_WORKERS=1
