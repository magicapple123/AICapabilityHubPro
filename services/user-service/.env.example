SERVICE_NAME=user-service
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8081
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_CLUSTER=DEFAULT
NACOS_MODEL_CONFIG_ENABLED=false
NACOS_MODEL_CONFIG_DATA_ID=user-service-model.json
NACOS_CONFIG_TIMEOUT=5
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/user_db?charset=utf8mb4
INTERNAL_CALL_TIMEOUT=10

# 必须与网关的 JWT_SECRET / JWT_ISSUER 完全一致，否则登录成功但经网关访问返回 1001。
# 下面是本地占位值，UTF-8 编码后至少 32 字节；真实密钥只放在本地 .env，不提交仓库。
JWT_SECRET=change-this-local-secret-to-at-least-32-bytes
JWT_ISSUER=ai-capability-hub
API_KEY_JWT_TTL_SECONDS=900
JWT_TTL_HOURS=24

# 注册赠送的初始积分（整数）。
INITIAL_POINTS=100

USE_MOCK=true
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=replace-me
