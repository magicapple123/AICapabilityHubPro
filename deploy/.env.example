# Compose 从 deploy 目录执行时会自动读取 deploy/.env。
MYSQL_ROOT_PASSWORD=root

# Nginx 对外端口；若 80 被占用可改成 8088 等未占用端口。
NGINX_PORT=80

# 网关运行在宿主机时使用此默认值；容器化网关时改为对应服务名:端口。
NGINX_GATEWAY_UPSTREAM=host.docker.internal:8080

# React 在 Nginx 镜像构建时注入的配置。
VITE_API_BASE_URL=/api
VITE_USE_MOCK_LOGIN=false

# Docker 构建下载前端依赖的 npm 源；网络正常时保持官方源。
# NPM_REGISTRY=https://registry.npmmirror.com
