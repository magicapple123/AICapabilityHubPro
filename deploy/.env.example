# Compose 从 deploy 目录执行时会自动读取 deploy/.env。
# 完整字段说明见 deploy/.env.template（含各值的生成命令）。
MYSQL_ROOT_PASSWORD=

# 必填：user-service 签发 + gateway 验签共用；缺失时 compose 直接报错。
# 生成：openssl rand -hex 32
JWT_SECRET=
JWT_SECRET_PREVIOUS=
JWT_ISSUER=ai-capability-hub

# Nginx 对外端口；若 80 被占用可改成 8088 等未占用端口。
NGINX_PORT=80

# 容器化网关默认 gateway:8080；网关在宿主机时改为 host.docker.internal:8080。
NGINX_GATEWAY_UPSTREAM=gateway:8080

# React 在 Nginx 镜像构建时注入的配置。
VITE_API_BASE_URL=/api
VITE_USE_MOCK_LOGIN=false

# One-time bootstrap settings; an empty password prompts without echo.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_POINTS=1000

# Docker 构建下载前端依赖的 npm 源；网络正常时保持官方源。
# NPM_REGISTRY=https://registry.npmmirror.com

# 模型供应商密钥加密主密钥（base64 的 32 字节）。生成：openssl rand -base64 32
# 同一套数据库换机器时必须沿用同一个值，否则 t_model_provider 里已存的密钥密文
# 无法解密，能力调用会失败。
PROVIDER_MASTER_KEY_V1=
PROVIDER_ALLOWED_HOSTS=

# ---- 上游模型（演示环境必填）----
# 留空或 USE_MOCK=true 时平台返回内置 Mock 回复（界面会标注来源），可用于跑通
# 链路，但不能用于演示视频/答辩。填真实 Key 后必须同时设 USE_MOCK=false。
USE_MOCK=true
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT=30
MODEL_MAX_TOKENS=1024

# OpenAI 兼容层的别名覆盖。不设时使用代码内置默认值，会额外暴露
# deepseek-flash / chat-completions 两个指向同一能力的历史别名。
# 格式：模型名=能力ID，多个用逗号分隔。
OPENAI_COMPAT_MODEL_MAP=deepseek-chat=1

# Optional build mirrors; leave defaults for public registries.
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
MAVEN_MIRROR_URL=
