# =============================================================================
# AICapabilityHub Pro · 容器化部署环境模板
# =============================================================================
# 用法：
#   cp deploy/.env.template deploy/.env      # bash / Git Bash
#   Copy-Item deploy\.env.template deploy\.env    # PowerShell
# 然后按下面的注释填值（**不要**把真实值提交进 Git，deploy/.env 已被 .gitignore 忽略）。
#
# compose 会自动读取「compose 文件所在目录」的 .env，也就是 deploy/.env：
#   docker compose -f deploy/docker-compose.yml --profile app up -d
# 若想用别的文件：
#   docker compose --env-file deploy/.env.prod -f deploy/docker-compose.yml --profile app up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 数据库
# -----------------------------------------------------------------------------
# MySQL root 口令。容器首次初始化（数据卷为空）时写入，之后改这里不会改数据库里的口令。
# 生成：openssl rand -hex 24
#   PowerShell: [Convert]::ToHexString((1..24 | ForEach-Object { Get-Random -Maximum 256 }))
# 注意：一旦 aihub-pro-mysql-data 卷已存在，改这里只会让服务连不上，必须先改库里的口令。
MYSQL_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# 2. JWT（**必填**，缺失时 compose 直接报错，不会带空密钥启动）
# -----------------------------------------------------------------------------
# user-service 用它签发、gateway 用同一把验签；两侧不一致 = 全站 401。
# 要求：UTF-8 编码后 ≥32 字节（HS256 下限），生产请用 64 位十六进制随机串。
# 生成：openssl rand -hex 32
#   PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=
# 密钥轮换期填上一把旧密钥（新签发用 JWT_SECRET，验签新旧并行）；轮换完置空即下线旧 key。
JWT_SECRET_PREVIOUS=
JWT_ISSUER=ai-capability-hub

# -----------------------------------------------------------------------------
# 3. 模型供应商（ai-chat-service）
# -----------------------------------------------------------------------------
# 供应商 API Key 落库前用 AES-256-GCM 加密，主密钥必须是标准的 32 字节随机数的 base64。
# 生成：openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
# 留空时「新增/更新供应商」接口会失败关闭（已有供应商仍可读，因为解密也需要它 → 实际不可用）。
# 轮换主密钥需先把库里的密文用旧 key 解出、再用 v2 key 加密，本期只支持单把 v1 key。
PROVIDER_MASTER_KEY_V1=
# 允许模型调用的上游域名白名单，逗号分隔，精确匹配 host（不含协议与端口）。
# 例：api.deepseek.com,api.openai.com
# 留空 = 不限制（仅限本地演示，生产务必填写，否则存在 SSRF 风险）。
PROVIDER_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# 4. 端口
# -----------------------------------------------------------------------------
# 只有 Nginx 的宿主机端口可配；其余端口在 compose 里固定，改端口需同步改 compose：
#   gateway 8080 / user 8081 / billing 8082 / capability 8083 / ai-chat 8090
#   mysql 3306 / nacos 8848+9848 / sentinel 8858
# 80 被占用时改这里（例：8088），之后访问 http://localhost:8088。
NGINX_PORT=80

# -----------------------------------------------------------------------------
# 5. Nginx 反代目标
# -----------------------------------------------------------------------------
# 容器化部署保持 gateway:8080（compose 服务名 + 容器端口）。
# 只有「网关跑在宿主机、其它都在容器里」的混合调试场景才改成 host.docker.internal:8080。
NGINX_GATEWAY_UPSTREAM=gateway:8080

# -----------------------------------------------------------------------------
# 6. 前端构建参数（Nginx 镜像构建期注入，改完要重新 build nginx）
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_USE_MOCK_LOGIN=false
# NPM_REGISTRY=https://registry.npmmirror.com

# -----------------------------------------------------------------------------
# 7. 首次启动脚本（scripts/bootstrap_stack.ps1 / scripts/bootstrap_stack.sh）
# -----------------------------------------------------------------------------
# 管理员账号：脚本只在账号不存在时创建，重复执行不会重置口令。
BOOTSTRAP_ADMIN_USERNAME=admin
# 口令必须由部署方自己设置（>=12 位，含大小写/数字/符号）。留空时脚本交互式读取，不回显。
BOOTSTRAP_ADMIN_PASSWORD=
# 管理员初始积分
BOOTSTRAP_ADMIN_POINTS=1000

# -----------------------------------------------------------------------------
# 8. 构建镜像源（留空时使用官方默认源）
# -----------------------------------------------------------------------------
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
MAVEN_MIRROR_URL=
