# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# 覆盖率数据是本地 pytest --cov 的产物，曾被误提交，禁止入库
**/.coverage
**/.coverage.*

# 环境变量与密钥
.env
.env.*
!.env.example
# 部署模板：只有占位符，无真实值，必须入库（否则客户机拿不到字段清单）
!.env.template

# Java / Maven
target/
*.class

# Node / 前端
node_modules/
web/dist/

# IDE / 操作系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 本地数据与日志
deploy/data/
nacos-data/
*.log
# 演示数据播种脚本的本地状态文件：记录本次写入的会话 ID，随机器/环境变化，禁止入库
scripts/devtools/.seed_demo_data_state.json

# Local verification reports, safety snapshots, and generated evidence
artifacts/
test-results*.xml

# Agent-local workspace state
.workbuddy/
# CodeBuddy 协作数据（含子智能体会话记录，属本地工具状态，禁止入库）
.codebuddy/
# 临时工作目录（文档导出、联调脚本、铸造的临时令牌等），一律不入库
.tmp/
